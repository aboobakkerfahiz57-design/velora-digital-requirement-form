<script>

/* ================= PROGRESS ================= */

const form = document.getElementById("clientForm");
const progressFill = document.getElementById("progressFill");
const progressText = document.getElementById("progressText");

function updateProgress(){

    const fields = form.querySelectorAll(
        "input:not([type='checkbox']), select, textarea"
    );

    let completed = 0;

    fields.forEach(field => {

        if(field.value.trim() !== ""){
            completed++;
        }

    });

    const percentage =
        fields.length === 0
        ? 0
        : Math.round((completed / fields.length) * 100);

    progressFill.style.width = percentage + "%";
    progressText.textContent = percentage + "%";
}

form.addEventListener("input", updateProgress);
form.addEventListener("change", updateProgress);


/* ================= COLLECT DATA ================= */

function collectFormData(){

    const formData = new FormData(form);
    const data = {};

    for(const [key,value] of formData.entries()){

        if(data[key]){

            if(!Array.isArray(data[key])){
                data[key] = [data[key]];
            }

            data[key].push(value);

        }else{

            data[key] = value;

        }

    }

    return data;
}


/* ================= CREATE SUMMARY ================= */

function createSummary(){

    const data = collectFormData();

    let message = "";

    message += "VELORA DIGITAL\n";
    message += "━━━━━━━━━━━━━━━━━━━━\n";
    message += "NEW CLIENT PROJECT REQUIREMENT\n";
    message += "━━━━━━━━━━━━━━━━━━━━\n\n";

    for(const key in data){

        let value = data[key];

        if(Array.isArray(value)){
            value = value.join(", ");
        }

        if(value && value.toString().trim() !== ""){

            message += key.toUpperCase() + ":\n";
            message += value + "\n\n";

        }

    }

    message += "━━━━━━━━━━━━━━━━━━━━\n";
    message += "Submitted through VELORA DIGITAL\n";
    message += "Digital Presence. Elevated.\n";

    return message;
}


/* ================= WHATSAPP ================= */

function submitWhatsApp(){

    if(!form.checkValidity()){

        form.reportValidity();

        return;

    }

    const message = createSummary();

    const phone = "916360695474";

    const url =
        "https://wa.me/" +
        phone +
        "?text=" +
        encodeURIComponent(message);

    window.open(url, "_blank");

}


/* ================= EMAIL ================= */

function submitEmail(){

    if(!form.checkValidity()){

        form.reportValidity();

        return;

    }

    const message = createSummary();

    const subject =
        "New Client Requirement — VELORA DIGITAL";

    const url =
        "mailto:veloradigitalco.in@gmail.com" +
        "?subject=" +
        encodeURIComponent(subject) +
        "&body=" +
        encodeURIComponent(message);

    window.location.href = url;

}


/* ================= SAVE DRAFT ================= */

function saveDraft(){

    const data = {};

    const fields =
        form.querySelectorAll(
            "input, select, textarea"
        );

    fields.forEach(field => {

        if(field.type === "checkbox"){

            data[field.name] =
                field.checked;

        }else{

            data[field.name] =
                field.value;

        }

    });

    localStorage.setItem(
        "veloraClientDraft",
        JSON.stringify(data)
    );

}


/* ================= LOAD DRAFT ================= */

function loadDraft(){

    const saved =
        localStorage.getItem(
            "veloraClientDraft"
        );

    if(!saved) return;

    const data =
        JSON.parse(saved);

    const fields =
        form.querySelectorAll(
            "input, select, textarea"
        );

    fields.forEach(field => {

        if(data[field.name] === undefined){
            return;
        }

        if(field.type === "checkbox"){

            field.checked =
                data[field.name];

        }else{

            field.value =
                data[field.name];

        }

    });

    updateProgress();

}


/* Auto-save */

form.addEventListener(
    "input",
    saveDraft
);

form.addEventListener(
    "change",
    saveDraft
);

loadDraft();

</script>

